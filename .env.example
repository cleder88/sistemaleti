# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Extração de itens de PDF via IA (opcional)
DEEPSEEK_API_KEY=

# Rate limit distribuído (opcional; sem isso usa memória por instância)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Envio de e-mail do código de segurança para formatar o sistema.
# Configure UM dos provedores abaixo (Resend ou Brevo).
RESEND_API_KEY=
BREVO_API_KEY=
# Remetente, ex.: Sistema LETI <seguranca@seudominio.com>
EMAIL_FROM=
EMAIL_FROM_NAME=Sistema LETI
# Segredo extra para o hash dos códigos (opcional; usa a service role se vazio)
SYSTEM_RESET_CODE_SECRET=
